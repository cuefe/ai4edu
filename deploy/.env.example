# docker compose 用的配置：复制为 deploy/.env 后填写。上线步骤见 docs/试点上线清单.md

# 试点、正式环境填 prod：关闭接口文档和 mock 模型，启动时检查下面的密钥是否已替换
ENV=prod

# 数据库超级用户密码（只在容器内网使用）
POSTGRES_PASSWORD=

# 三个密钥都要换成随机值，生成后不能再改：改了 DATA_ENCRYPTION_KEY、PHONE_HASH_KEY，已有的手机号就读不出来了
# JWT_SECRET 至少 32 个字符：openssl rand -hex 32
# DATA_ENCRYPTION_KEY：docker compose run --rm api python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
DATA_ENCRYPTION_KEY=
PHONE_HASH_KEY=

# 短信：none = 没开通短信，只能密码登录，危机预警只发站内信（生产环境不能用 console）
SMS_PROVIDER=none

# 经过 Cloudflare 等 CDN 时填 cf-connecting-ip，审计日志里才是学生、老师的真实 IP
CLIENT_IP_HEADER=

# API 进程数：2 核 4G 填 2
API_WORKERS=2

# 防刷量：老师每天发起 AI 生成的次数、学生每天在问一问里发的消息数（不填用默认的 60、200）
TEACHER_DAILY_AI_TASKS=
STUDENT_DAILY_TUTOR_MESSAGES=

# 大模型
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
