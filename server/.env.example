# 复制为 .env 后按需修改。本地开发不建 .env 也能跑（默认连 cli db-start 启动的数据库）。

ENV=dev

# 迁移用表所有者账号；应用运行用受行级安全约束的普通账号（不能是超级用户）
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:54329/ai4edu
APP_DATABASE_URL=postgresql+psycopg://ai4edu_app@127.0.0.1:54329/ai4edu
APP_DB_ROLE=ai4edu_app

# memory:// = 内存版 Redis，Celery 任务同步执行；生产填 redis://...
REDIS_URL=memory://

# 生产环境必须修改以下三项（启动时会检查）
# JWT_SECRET 至少 32 个字符；DATA_ENCRYPTION_KEY 用下面命令生成：
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
DATA_ENCRYPTION_KEY=
PHONE_HASH_KEY=

# console = 验证码打印在后端日志里（仅开发）；none = 不开通短信，只能密码登录，危机预警只发站内信
SMS_PROVIDER=console
# SMS_DAILY_LIMIT=10

# 经过 Cloudflare 等 CDN 时填 cf-connecting-ip，审计日志里才是真实 IP
# CLIENT_IP_HEADER=

# 防刷量：老师每天发起 AI 生成的次数、学生每天在问一问里发的消息数
# TEACHER_DAILY_AI_TASKS=60
# STUDENT_DAILY_TUTOR_MESSAGES=200

# 每个 API 进程的线程数和数据库连接池；线程数要比 DB_POOL_SIZE + DB_MAX_OVERFLOW 至少小 5
# API_THREADS=30
# DB_POOL_SIZE=10
# DB_MAX_OVERFLOW=30

# 问一问里学生流露危机念头时显示的求助电话（JSON 数组，可以按地区调整）
# CRISIS_HOTLINES=["全国心理援助热线：12356","青少年服务台：12355","遇到紧急危险，请立即拨打 110 或 120"]
# 危机预警多少小时没处理算超时
# CRISIS_ESCALATE_HOURS=2

# 上传资料的存放目录（默认 server/.data/files）；API 和 Worker 要能访问同一个目录
# STORAGE_DIR=
# MAX_UPLOAD_MB=50

# —— 大模型（两家都配才能用全部技能；都不配时开发环境用 mock 模型）——
DEEPSEEK_API_KEY=
# 阿里云百炼（通义）
DASHSCOPE_API_KEY=
AI_ALLOW_MOCK=true
