# 复制为 .env 后按需修改。本地开发不建 .env 也能跑（默认连 cli db-start 启动的数据库）。

ENV=dev

# 迁移用表所有者账号；应用运行用受行级安全约束的普通账号（不能是超级用户）
DATABASE_URL=postgresql+psycopg://postgres@127.0.0.1:54329/ai4edu
APP_DATABASE_URL=postgresql+psycopg://ai4edu_app@127.0.0.1:54329/ai4edu
APP_DB_ROLE=ai4edu_app

# memory:// = 内存版 Redis，Celery 任务同步执行；生产填 redis://...
REDIS_URL=memory://

# 生产环境必须修改以下三项（启动时会检查）
# JWT_SECRET 至少 32 个字符；DATA_ENCRYPTION_KEY 用下面命令生成：
#   uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JWT_SECRET=
DATA_ENCRYPTION_KEY=
PHONE_HASH_KEY=

# console = 验证码打印在后端日志里
SMS_PROVIDER=console

# —— 大模型（至少配一家；都不配时开发环境用 mock 模型）——
# 火山方舟（豆包）：模型 ID 或接入点 ID 在方舟控制台查看
ARK_API_KEY=
ARK_MODEL_FLAGSHIP=
ARK_MODEL_STANDARD=
ARK_MODEL_REASONING=
ARK_MODEL_VISION=
ARK_MODEL_FAST=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=
AI_ALLOW_MOCK=true
